<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aero_bringup</name>
  <version>1.0.0</version>
  <description>Launch files and configuration for the AERO project.</description>
  <maintainer email="nikhil@aero.local">Nikhil</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>aero_interfaces</depend>
  <depend>aero_controller</depend>
  <depend>aero_perception</depend>
  <depend>aero_exploration</depend>
  <depend>aero_safety</depend>
  <depend>aero_commander</depend>
  <depend>aero_dashboard</depend>
  <depend>aero_eval</depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
